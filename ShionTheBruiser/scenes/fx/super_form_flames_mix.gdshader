shader_type canvas_item;
render_mode blend_mix;

// Super Form (Act 4): recolors the game's red power-up flames (NPowerUpVfx) to a Super Saiyan gold.
// Applied from C# (SuperFormFlames in Strife/RingVisuals.cs) in place of each node's material, keeping its blend mode.

// Hue rotation (0..1 = a full turn): red/orange flames to gold
uniform float hue_shift = 0.1;
uniform float saturation = 0.95;
uniform float brightness = 1.15;
// Slightly transparent
uniform float opacity = 0.75;

vec3 rgb2hsv(vec3 c) {
	vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
	vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
	vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
	float d = q.x - min(q.w, q.y);
	float e = 1.0e-10;
	return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

vec3 hsv2rgb(vec3 c) {
	vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
	vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
	return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

void fragment() {
	vec4 color = texture(TEXTURE, UV) * COLOR;
	vec3 hsv = rgb2hsv(color.rgb);
	hsv.x = fract(hsv.x + hue_shift);
	hsv.y = clamp(hsv.y * saturation, 0.0, 1.0);
	hsv.z = hsv.z * brightness;
	COLOR = vec4(hsv2rgb(hsv), color.a * opacity);
}
